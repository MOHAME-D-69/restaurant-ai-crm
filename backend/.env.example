# Set true while you only want to run the API without a database.
SKIP_DB=true
PORT=3000

# PostgreSQL connection string
# Local example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/restaurant_crm

# For hosted PostgreSQL providers that require SSL:
DATABASE_SSL=false
DB_POOL_MAX=10

JWT_SECRET=change_this_secret
N8N_API_KEY=change_this_n8n_key
NODE_ENV=development
